# ─────────────────────────────────────────────────────────────────────────────
# Auraplex website — environment template
#
# Copy to .env.local for development (.env*.local is gitignored). The app reads
# the public-site variables below plus server-only integration variables.
#
# NEXT_PUBLIC_* is inlined by Next at BUILD time. Under Nomad that means these
# must be correct when the image is built — setting them only in the job's
# env{} block will not change an already-built image. Server-only integration
# values below are read at runtime and belong in the deployment secret store or
# job spec. Empty values are intentional; never commit real credentials here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site origin ──────────────────────────────────────────────────────────────
# Drives every canonical, hreflang, OG URL, JSON-LD entity URL, sitemap and
# robots entry. No trailing slash. Defaults to https://auraplex.com.my in
# lib/seo.ts if unset. The intended production host in Dockerfile is www.
NEXT_PUBLIC_SITE_URL=https://www.auraplex.info

# ── FAQ chatbot (required for the floating widget) ───────────────────────────
# Self-hosted RAG API deployed under Nomad on the Auraplex on-prem stack.
# No trailing slash. components/forms/auraplex-faq-chat.tsx also hard-codes
# this value as a fallback, so the widget survives the var being unset.
NEXT_PUBLIC_CHAT_API_URL=https://chat-api.auraplex.info

# ── Sanity CMS (optional) ────────────────────────────────────────────────────
# Unset is fine: content falls back to lib/catalog.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
# Shared secret for the /api/revalidate webhook (Sanity → on-demand ISR).
# You choose this value; generate a strong one.
SANITY_REVALIDATE_SECRET=

# ── Transactional email (required in production) ─────────────────────────────
# Since lib/kv.ts became a no-op stub in the move off Vercel, Resend is the
# ONLY delivery path for quote / contact / internship / spec-sheet leads.
# Without this key those submissions are lost.
RESEND_API_KEY=

# ── Knowledge-base uploads ───────────────────────────────────────────────────
# The admin upload workspace moved to its own app in knowledge/ — its
# Keycloak, MinIO and Qdrant settings live in knowledge/.env.example.

# ── Reserved ─────────────────────────────────────────────────────────────────
# Set in deploy/website.nomad.hcl but not read by any source file yet.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=auraplex.info

# NOTE: the KV_* variables that used to live here are gone. lib/kv.ts is a
# no-op stub now that the app runs off Vercel; the follow-up is a standalone
# Redis under Nomad, which will introduce its own var.
