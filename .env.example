# ─────────────────────────────────────────────────────────────────────────────
# Auraplex Admin — environment template
#
# Copy to .env.local for development (.env*.local is gitignored). Every value
# below except NEXT_PUBLIC_ADMIN_UPLOAD_MAX_MB is server-only and read at
# RUNTIME; in a deployment they belong in the secret store or job spec, not in
# the image. Empty values are intentional; never commit real credentials here.
#
# Each variable is marked with what it is needed for:
#   [auth]        required for authentication
#   [storage]     required for upload and storage
#   [qdrant]      required for complete Qdrant functionality
#   [optional]    optional, or has a default
#   [conditional] only in the situation described
#
# Nothing has been deployed. Where a comment gives a production or staging
# value, it is a value Friendy confirmed, not a description of a running
# environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── App origin / runtime ─────────────────────────────────────────────────────
# [auth] Public origin of this application, no trailing slash. Used for the
# Keycloak post-logout redirect (<AUTH_URL>/signed-out). It is not checked at
# startup: without it, logout only clears the local session and the Keycloak
# session is left open. Set it in every environment behind an ingress.
#   Production (confirmed; set in deploy/admin.nomad.hcl):
#     https://admin-auraplex.auraplex.info
#   Staging (confirmed hostname; documented only, no staging job exists):
#     https://admin-auraplex-staging.auraplex.info
#   Local: http://localhost:3000
AUTH_URL=
# [conditional] Only enable CF IP parsing when APISIX strips client-supplied
# x-auraplex-proxy-secret and injects the same secret at the trusted ingress.
ADMIN_TRUSTED_PROXY_SECRET=
# [optional] PORT and HOSTNAME are read by the Next.js standalone server
# itself. The Dockerfile sets them (3000 and 0.0.0.0); override them in the
# job spec.

# ── Auth / Keycloak ──────────────────────────────────────────────────────────
# [auth] Encrypts the session cookie and the Proxy identity handoff. Without
# it every protected route answers 503.
AUTH_SECRET=
# The client must issue refresh tokens and put `groups` in the ID token: every
# admin session is re-verified with Keycloak (refresh-token grant) once its
# last verification is 60 seconds old. That window is fixed in code, not here.
# [auth] All three are required together with AUTH_SECRET.
#   Confirmed issuer:    https://keycloak.auraplex.info/realms/auraplex
#   Confirmed client ID: auraplex-admin-upload (confidential client)
# Both are set in deploy/admin.nomad.hcl for production.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
# Confirmed source: Vault, kv/auraplex/admin-upload/keycloak_client_secret.
# That is a path, not a value, and the injection is not wired yet (Friendy
# handles it as part of the deployment). Never
# write the real secret in this file, the job spec or the image.
KEYCLOAK_CLIENT_SECRET=
# [optional] If left empty, the task-spec defaults are auraplex-uploader and
# auraplex-admin.
KEYCLOAK_UPLOADER_ROLE=
KEYCLOAK_ADMIN_ROLE=

# ── Storage / MinIO ──────────────────────────────────────────────────────────
# [storage] All three are required: without them uploads, the recent uploads
# list and delete answer 503 BACKEND_NOT_CONFIGURED.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# [optional] Defaults to us-east-1.
MINIO_REGION=

# ── Qdrant (upload status lookup and delete) ─────────────────────────────────
# Collections are fixed per ingest line (machines -> auraplex_machines,
# software -> auraplex_software, consulting -> auraplex_consulting); there is
# no QDRANT_COLLECTION setting.
# [qdrant] Uploads work without it, but processing status is then unavailable
# and delete is refused.
QDRANT_URL=
# [conditional] Only when the Qdrant deployment requires a key.
QDRANT_API_KEY=

# ── Upload limits ────────────────────────────────────────────────────────────
# Two separate settings: a RUNTIME server limit and a BUILD-time UI ceiling.
# [optional] Server-enforced RUNTIME cap (1-500 MB), read on each request.
# Unset, the application default of 100 MB applies; that is the fallback for
# development and testing.
#   Production (confirmed: 300 MB; set in deploy/admin.nomad.hcl): 300
# The ingress and MinIO must allow request bodies of at least this size.
ADMIN_UPLOAD_MAX_MB=
# [optional] Concurrent uploads per Node.js process (1-16); defaults to 4.
# Per process, not cluster-wide: each Nomad allocation has its own limit.
ADMIN_UPLOAD_MAX_CONCURRENT=
# [conditional] BUILD-time UI-only ceiling, inlined into the JavaScript bundle
# when the image is built (Docker build argument); changing it at runtime has
# no effect. The UI shows the lower of this and the runtime cap, and the
# server enforces the runtime cap whatever this is. Unset, the UI follows the
# runtime cap.
#   Production build: leave unset, or set 300. A lower value would hold the UI
#   below the 300 MB server cap.
NEXT_PUBLIC_ADMIN_UPLOAD_MAX_MB=
