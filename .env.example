# ─────────────────────────────────────────────────────────────────────────────
# Auraplex Admin — environment template
#
# Copy to .env.local for development (.env*.local is gitignored). Every value
# below except NEXT_PUBLIC_ADMIN_UPLOAD_MAX_MB is server-only and read at
# RUNTIME; in a deployment they belong in the secret store or job spec, not in
# the image. Empty values are intentional; never commit real credentials here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin upload authentication (server-only, runtime) ───────────────────────
AUTH_SECRET=
# Public app origin for Keycloak post-logout redirect (server-only at runtime).
AUTH_URL=
# The client must issue refresh tokens and put `groups` in the ID token: every
# admin session is re-verified with Keycloak (refresh-token grant) once its
# last verification is 60 seconds old. That window is fixed in code, not here.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# If left empty, the task-spec defaults are auraplex-uploader and
# auraplex-admin.
KEYCLOAK_UPLOADER_ROLE=
KEYCLOAK_ADMIN_ROLE=
# Optional build-time UI ceiling; leave unset so the UI follows the runtime cap.
NEXT_PUBLIC_ADMIN_UPLOAD_MAX_MB=
# Server-enforced runtime cap (1-500 MB); defaults to 100 MB. Verify ingress
# and MinIO limits before raising this in production.
ADMIN_UPLOAD_MAX_MB=
# Concurrent uploads per Node.js process (1-16); defaults to 4. Per process,
# not cluster-wide: each Nomad allocation has its own limit.
ADMIN_UPLOAD_MAX_CONCURRENT=
# Optional: only enable CF IP parsing when APISIX strips client-supplied
# x-auraplex-proxy-secret and injects the same secret at the trusted ingress.
ADMIN_TRUSTED_PROXY_SECRET=

# ── Admin upload object storage (server-only, runtime) ───────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=

# ── Admin upload status lookup (server-only, runtime) ────────────────────────
# Collections are fixed per ingest line (machines -> auraplex_machines,
# software -> auraplex_software, consulting -> auraplex_consulting); there is
# no QDRANT_COLLECTION setting.
QDRANT_URL=
# Optional only when the confirmed Qdrant deployment does not require a key.
QDRANT_API_KEY=
