# ─────────────────────────────────────────────────────────────────────────────
# NOT PRODUCTION-READY — EXAMPLE ONLY. DO NOT `nomad job run` THIS FILE.
#
# This is a starting point for the standalone Auraplex Admin job. Its
# deployment identity has NOT been decided yet: job name, service name, image,
# datacenter, port, domain, ingress route, Keycloak client and secret paths.
# Every such value below is a CHANGE_ME_AURAPLEX_ADMIN_* placeholder on
# purpose. The values to confirm are listed in
# docs/deployment/AURAPLEX-ADMIN-deployment.md.
#
# It deliberately does not reuse the public website's identity (its job,
# service or image names), so applying it can never replace that job. Do not
# put those names back. The public website also listens on host port 3000 with
# host networking; the Admin job needs its own port.
# ─────────────────────────────────────────────────────────────────────────────
job "CHANGE_ME_AURAPLEX_ADMIN_JOB" {
  datacenters = ["CHANGE_ME_AURAPLEX_ADMIN_DATACENTER"]
  type        = "service"

  group "web" {
    # The application keeps session-ordering and rate-limit state in process
    # memory. Run exactly one instance until that is redesigned.
    count = 1

    network {
      mode = "host"
    }

    restart {
      attempts = 5
      interval = "5m"
      delay    = "15s"
      mode     = "delay"
    }

    task "next" {
      driver = "docker"

      config {
        image        = "CHANGE_ME_AURAPLEX_ADMIN_IMAGE"
        network_mode = "host"
      }

      env {
        NODE_ENV = "production"
        PORT     = "CHANGE_ME_AURAPLEX_ADMIN_PORT"
        HOSTNAME = "0.0.0.0"
        # Admin secrets, AUTH_URL (for Keycloak RP logout), group mapping and
        # service addresses must be injected via templates + nomadVar. The
        # production variable path is intentionally not guessed here; see
        # docs/deployment/AURAPLEX-ADMIN-deployment.md and .env.example.
        # Upload size: ADMIN_UPLOAD_MAX_MB is the server-enforced RUNTIME cap
        # (default 100 MB, range 1-500) and the admin UI follows it without a
        # rebuild. NEXT_PUBLIC_ADMIN_UPLOAD_MAX_MB is an optional build-time
        # UI-only ceiling; leave it unset unless the UI must stay lower.
        # ADMIN_UPLOAD_MAX_CONCURRENT (default 4, range 1-16) caps concurrent
        # uploads PER ALLOCATION/PROCESS, sized for the 1024 MB memory below;
        # it is not a cluster-wide limit.
      }

      resources {
        cpu    = 1000
        memory = 1024
      }
    }

    service {
      name     = "CHANGE_ME_AURAPLEX_ADMIN_SERVICE"
      provider = "consul"
      port     = "CHANGE_ME_AURAPLEX_ADMIN_PORT"

      check {
        name     = "healthz"
        type     = "http"
        # Liveness only: public, no session, and no call to Keycloak, MinIO
        # or Qdrant. It proves the server process answers, not that those
        # services are reachable.
        path     = "/api/health"
        port     = "CHANGE_ME_AURAPLEX_ADMIN_PORT"
        interval = "30s"
        timeout  = "5s"
      }
    }
  }
}
