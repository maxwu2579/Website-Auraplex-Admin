# ─────────────────────────────────────────────────────────────────────────────
# Auraplex Knowledge — environment template
#
# Copy to .env.local for development (.env*.local is gitignored). Everything
# here is server-only and read at RUNTIME; in production it belongs in the
# deployment secret store (Nomad templates + nomadVar). Empty values are
# intentional; never commit real credentials here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (Auth.js + Keycloak) ──────────────────────────────────────
AUTH_SECRET=
# Public origin of THIS app (e.g. https://knowledge.auraplex.info). Used for
# the Keycloak post-logout redirect back to the landing page.
AUTH_URL=
# The client must issue refresh tokens and put `groups` in the ID token: every
# session is re-verified with Keycloak (refresh-token grant) once its last
# verification is 60 seconds old. Register <AUTH_URL>/api/auth/callback/keycloak
# as a redirect URI and <AUTH_URL>/ as a post-logout redirect URI.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# If left empty, the defaults are auraplex-uploader and auraplex-admin.
KEYCLOAK_UPLOADER_ROLE=
KEYCLOAK_ADMIN_ROLE=

# ── Upload limits ────────────────────────────────────────────────────────────
# Server-enforced runtime cap (1-500 MB); defaults to 100 MB. Verify ingress
# and MinIO limits before raising this in production.
ADMIN_UPLOAD_MAX_MB=
# Optional build-time UI ceiling; leave unset so the UI follows the runtime cap.
NEXT_PUBLIC_ADMIN_UPLOAD_MAX_MB=
# Concurrent uploads per Node.js process (1-16); defaults to 4.
ADMIN_UPLOAD_MAX_CONCURRENT=
# Optional: only enable CF IP parsing when APISIX strips client-supplied
# x-auraplex-proxy-secret and injects the same secret at the trusted ingress.
ADMIN_TRUSTED_PROXY_SECRET=

# ── Object storage (MinIO) ───────────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=

# ── Knowledge index (Qdrant) — processed-status lookup and admin delete ──────
# Collections are fixed per ingest line (machines -> auraplex_machines,
# software -> auraplex_software, consulting -> auraplex_consulting).
QDRANT_URL=
# Optional only when the Qdrant deployment does not require a key.
QDRANT_API_KEY=
